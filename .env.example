# URL công khai của site (dùng cho sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://ielts-master.vercel.app

# Khoá Anthropic để bật chấm Writing/Speaking bằng AI (chỉ dùng phía server, KHÔNG lộ ra trình duyệt)
ANTHROPIC_API_KEY=
# Model dùng để chấm (tuỳ chọn)
ANTHROPIC_MODEL=claude-sonnet-4-6
# Số lượt chấm AI tối đa / IP / giờ
AI_RATE_LIMIT_PER_HOUR=20

# Thanh toán gói Pro (link checkout) hoặc email liên hệ
NEXT_PUBLIC_CHECKOUT_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
